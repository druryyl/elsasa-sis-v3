{
  "name": "elsasa-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "api:generate": "openapi-typescript https://localhost:52390/swagger/v1/swagger.json -o src/shared/types/api/schema.d.ts"
  },
  "dependencies": {
    "@primevue/themes": "^4.2.0",
    "@tanstack/vue-query": "^5.60.0",
    "@vee-validate/zod": "^4.14.0",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.0",
    "date-fns": "^4.1.0",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.0",
    "primevue": "^4.2.0",
    "uuid": "^10.0.0",
    "vee-validate": "^4.14.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^25.0.0",
    "msw": "^2.6.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}

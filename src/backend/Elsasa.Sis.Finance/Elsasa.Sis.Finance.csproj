<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage 1 Finance domain assembly (ADR-001, ADR-010).
    May reference only Shared and Contracts; must never reference Operations or
    Students. Compile-time isolation is verified by the architecture tests.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Elsasa.Sis.Shared/Elsasa.Sis.Shared.csproj" />
    <ProjectReference Include="../Elsasa.Sis.Contracts/Elsasa.Sis.Contracts.csproj" />
  </ItemGroup>

</Project>

<Project>

  <!--
    Authoritative backend build configuration (slice P1-S01).

    This file is evaluated directly by projects under src/backend/ because
    MSBuild uses the nearest Directory.Build.props found while walking up from
    the project directory. The repository root Directory.Build.props imports
    this file so projects outside src/backend/ (for example tests/backend/)
    inherit the exact same compilation baseline.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Quality gates that back the "zero compiler warnings" baseline required by
    docs/architecture/coding-conventions.md. Diagnostics are enforced by the
    compiler/analyzers, not suppressed; do not add blanket NoWarn entries.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
